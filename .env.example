# Copia este archivo como .env y completa los valores. .env no se sube a git.

# Conexión de la API. En producción: pooler de Supabase en modo transacción (puerto 6543)
# con ?pgbouncer=true&connection_limit=1. En local, la base de Docker.
DATABASE_URL=postgresql://pm:pm@localhost:5433/pm_dev

# Conexión de las migraciones. En producción: pooler de Supabase en modo sesión (puerto 5432).
DIRECT_URL=postgresql://pm:pm@localhost:5433/pm_dev

# Supabase Storage (solo servidor; la clave de servicio nunca va al cliente).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=anexos

# Zona horaria para calcular "hoy". Producción: America/Lima.
APP_TIMEZONE=America/Lima

# Código que exige la configuración inicial. Obligatorio en producción.
SETUP_TOKEN=

# PostgreSQL local para las pruebas del servidor (no se usa en producción).
TEST_DATABASE_URL=postgresql://pm:pm@localhost:5433/postgres
