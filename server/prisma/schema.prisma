generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               String
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions            Session[]
  memberships         ProjectMember[]
  assignments         TaskAssignee[]
  timeEntries         TimeEntry[]
  comments            TaskComment[]
  attachments         Attachment[]
  ownedRisks          Risk[]
  approvedCharters    Charter[]
  completedSteps      TaskStep[]
  raciCells           RaciCell[]
  baselines           Baseline[]
  decidedChanges      ChangeRequest[]      @relation("ChangeDecider")
  requestedChanges    ChangeRequest[]      @relation("ChangeRequester")
  appliedChanges      ChangeRequest[]      @relation("ChangeApplier")
  reportedIncidents   Incident[]           @relation("incidentReporter")
  ownedIncidents      Incident[]           @relation("incidentOwner")
  deliverableReviews  DeliverableReview[]  @relation("deliverableReviewer")
  closedProjects      ProjectClosure[]     @relation("projectCloser")
  reopenedProjects    ProjectClosure[]     @relation("projectReopener")
  lessons             Lesson[]             @relation("lessonAuthor")
  activityLogs        ActivityLog[]
  notifications       Notification[]
  statusReports       StatusReport[]
  communicationItems  CommunicationItem[]
  createdMeetings     Meeting[]
  meetingAttendances  MeetingAttendee[]
  meetingAgreements   MeetingAgreement[]
  qualityMeasurements QualityMeasurement[]
  riskAssessments     RiskAssessment[]
  ownedAssumptions    Assumption[]         @relation("assumptionOwner")
  pausedProjects      ProjectPause[]       @relation("projectPauser")
  resumedProjects     ProjectPause[]       @relation("projectResumer")
  charterVersions     CharterVersion[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fallos de inicio de sesión por correo e IP, en ventanas de 15 minutos.
model LoginAttempt {
  key          String    @id
  failures     Int
  windowStart  DateTime
  blockedUntil DateTime?
}

model FileDeletion {
  storedName String   @id
  createdAt  DateTime @default(now())
}

model Project {
  id                      String    @id @default(cuid())
  name                    String
  description             String    @default("")
  status                  String    @default("PLANNING")
  approach                String    @default("PREDICTIVE")
  startDate               String?
  endDate                 String?
  plannedBudgetCents      BigInt    @default(0)
  contingencyReserveCents BigInt    @default(0)
  managementReserveCents  BigInt    @default(0)
  currency                String    @default("USD")
  /// Último número de solicitud de cambio usado; los números no se reutilizan aunque se borre una solicitud.
  lastChangeNumber        Int       @default(0)
  lastIncidentNumber      Int       @default(0)
  lastDecisionNumber      Int       @default(0)
  lastDeliverableNumber   Int       @default(0)
  lastStatusReportNumber  Int       @default(0)
  lastRequirementNumber   Int       @default(0)
  lastAssumptionNumber    Int       @default(0)
  /// Umbrales de salud (F16): tareas vencidas para «En riesgo», % del presupuesto e índice mínimo (centésimas) para «Atención», puntaje de riesgo alto.
  healthOverdueTasks      Int       @default(3)
  healthBudgetPercent     Int       @default(90)
  healthIndexMin          Int       @default(90)
  highRiskScore           Int       @default(15)
  /// C13: si es falso, sus lecciones no aparecen en la biblioteca para quien no es miembro.
  shareLessons            Boolean   @default(true)
  lastCharterVersion      Int       @default(0)
  /// Cada cuánto se emite el informe de estado: NONE, WEEKLY, BIWEEKLY, MONTHLY.
  statusReportFrequency   String    @default("NONE")
  closedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  members          ProjectMember[]
  roles            ProjectRole[]
  charter          Charter?
  objectives       Objective[]
  milestones       Milestone[]
  tasks            Task[]
  attachments      Attachment[]
  stakeholders     Stakeholder[]
  risks            Risk[]
  expenses         Expense[]
  raciActivities   RaciActivity[]
  baselines        Baseline[]
  changeRequests   ChangeRequest[]
  evmSnapshots     EvmSnapshot[]
  incidents        Incident[]
  decisions        Decision[]
  deliverables     Deliverable[]
  closures         ProjectClosure[]
  lessons          Lesson[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  budgetCategories BudgetCategory[]
  statusReports    StatusReport[]
  communications   CommunicationItem[]
  meetings         Meeting[]
  requirements     Requirement[]
  qualityMetrics   QualityMetric[]
  assumptions      Assumption[]
  pauses           ProjectPause[]     @relation("pausedProject")
  prioritizedOver  ProjectPause[]     @relation("priorityProject")
  charterVersions  CharterVersion[]
}

model ProjectMember {
  id                  String   @id @default(cuid())
  projectId           String
  userId              String
  projectRole         String   @default("")
  /**
   * Tarifa por hora en centavos; solo la ve el PM.
   */
  hourlyRateCents     BigInt   @default(0)
  weeklyCapacityHours Int      @default(40)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectRole {
  id        String  @id @default(cuid())
  projectId String
  name      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Charter {
  id              String    @id @default(cuid())
  projectId       String    @unique
  justification   String    @default("")
  scopeIncluded   String    @default("")
  scopeExcluded   String    @default("")
  boundaries      String    @default("")
  assumptions     String    @default("")
  constraints     String    @default("")
  successCriteria String    @default("")
  sponsor         String    @default("")
  status          String    @default("DRAFT")
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  version         Int       @default(1)
  updatedAt       DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation(fields: [approvedById], references: [id], onDelete: SetNull)
}

model Objective {
  id          String   @id @default(cuid())
  projectId   String
  description String
  metric      String   @default("")
  target      String   @default("")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  name      String
  dueDate   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  deliverables Deliverable[]
  forecasts    MilestoneForecast[]

  @@index([projectId])
}

model Task {
  id               String   @id @default(cuid())
  projectId        String
  milestoneId      String?
  parentId         String?
  position         Int      @default(0)
  deliverableId    String?
  title            String
  description      String   @default("")
  status           String   @default("TODO")
  priority         String   @default("MEDIUM")
  startDate        String?
  dueDate          String?
  progress         Int      @default(0)
  plannedCostCents BigInt   @default(0)
  estimatedHours   Decimal? @db.Decimal(7, 2)
  createdAt        DateTime @default(now())
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent            Task?              @relation("TaskTree", fields: [parentId], references: [id], onDelete: NoAction)
  children          Task[]             @relation("TaskTree")
  deliverable       Deliverable?       @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  assignees         TaskAssignee[]
  predecessors      TaskDependency[]   @relation("successor")
  successors        TaskDependency[]   @relation("predecessor")
  comments          TaskComment[]
  attachments       Attachment[]
  steps             TaskStep[]
  expenses          Expense[]
  incidents         Incident[]
  timeEntries       TimeEntry[]
  meetingAgreements MeetingAgreement[]

  @@index([projectId])
  @@index([parentId])
}

model TaskStep {
  id         String   @id @default(cuid())
  taskId     String
  title      String
  done       Boolean  @default(false)
  completedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User? @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskDependency {
  predecessorId String
  successorId   String
  /**
   * FS, SS, FF o SF.
   */
  type          String   @default("FS")
  lagDays       Int      @default(0)
  createdAt     DateTime @default(now())

  predecessor Task @relation("predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model Attachment {
  id           String    @id @default(cuid())
  projectId    String
  taskId       String?
  uploadedById String
  originalName String
  storedName   String    @unique
  mimeType     String
  size         Int
  /// Nulo mientras el archivo no se ha subido y confirmado.
  uploadedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  deliverableReviews DeliverableReview[]

  @@index([projectId])
  @@index([taskId])
}

model Stakeholder {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  organization      String   @default("")
  position          String   @default("")
  contact           String   @default("")
  influence         String   @default("MEDIUM")
  interest          String   @default("MEDIUM")
  strategy          String   @default("")
  /// Involucramiento: UNAWARE, RESISTANT, NEUTRAL, SUPPORTIVE, LEADING; null si no se evaluó.
  currentEngagement String?
  desiredEngagement String?
  expectations      String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raciCells          RaciCell[]
  deliverableReviews DeliverableReview[]
  meetingAttendances MeetingAttendee[]
  requirements       Requirement[]

  @@index([projectId])
}

model Risk {
  id                   String   @id @default(cuid())
  projectId            String
  description          String
  type                 String
  probability          Int
  impact               Int
  response             String
  responsePlan         String   @default("")
  ownerId              String?
  status               String   @default("OPEN")
  /// F15: disparador, próxima revisión, costo de contingencia (solo PM) y evaluación residual.
  trigger              String   @default("")
  nextReviewDate       String?
  contingencyCostCents BigInt?
  residualProbability  Int?
  residualImpact       Int?
  createdAt            DateTime @default(now())
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  incidents   Incident[]
  assessments RiskAssessment[]
  assumptions Assumption[]

  @@index([projectId])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  description String
  amountCents BigInt
  date        String
  category    String
  taskId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
}

model RaciActivity {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cells   RaciCell[]

  @@index([projectId])
}

model RaciCell {
  id            String   @id @default(cuid())
  activityId    String
  stakeholderId String?
  userId        String?
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activity    RaciActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@unique([activityId, stakeholderId])
  @@index([stakeholderId])
  @@index([userId])
}

model Baseline {
  id              String   @id @default(cuid())
  projectId       String
  version         Int
  reason          String   @default("")
  bacCents        BigInt
  startDate       String?
  endDate         String?
  changeRequestId String?
  createdById     String
  createdAt       DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks         BaselineTask[]

  @@unique([projectId, version])
}

model BaselineTask {
  id               String @id @default(cuid())
  baselineId       String
  taskId           String
  title            String
  startDate        String
  dueDate          String
  plannedCostCents BigInt

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId])
}

model ChangeRequest {
  id                 String    @id @default(cuid())
  projectId          String
  number             Int
  title              String
  description        String    @default("")
  requestedBy        String    @default("")
  scopeImpact        String    @default("")
  scheduleImpactDays Int?
  costImpactCents    BigInt?
  status             String    @default("PENDING")
  decisionNote       String    @default("")
  decidedAt          DateTime?
  decidedById        String?
  requestedById      String?
  appliedAt          DateTime?
  appliedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy       User?                      @relation("ChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  requestedByUser User?                      @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  appliedBy       User?                      @relation("ChangeApplier", fields: [appliedById], references: [id], onDelete: SetNull)
  baselines       Baseline[]
  decisions       Decision[]
  requirements    ChangeRequestRequirement[]

  @@unique([projectId, number])
  @@index([requestedById])
}

model EvmSnapshot {
  id        String @id @default(cuid())
  projectId String
  date      String
  bacCents  BigInt
  pvCents   BigInt
  evCents   BigInt
  acCents   BigInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
}

model Incident {
  id            String    @id @default(cuid())
  projectId     String
  number        Int
  title         String
  description   String    @default("")
  reportedById  String
  ownerId       String?
  priority      String    @default("MEDIUM")
  dueDate       String?
  status        String    @default("OPEN")
  resolution    String    @default("")
  taskId        String?
  riskId        String?
  /// INCIDENT, DEFECT o NONCONFORMITY.
  kind          String    @default("INCIDENT")
  deliverableId String?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy        User               @relation("incidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  owner             User?              @relation("incidentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  risk              Risk?              @relation(fields: [riskId], references: [id], onDelete: SetNull)
  deliverable       Deliverable?       @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  decisions         Decision[]
  meetingAgreements MeetingAgreement[]
  assumptions       Assumption[]

  @@unique([projectId, number])
  @@index([ownerId])
  @@index([reportedById])
  @@index([taskId])
  @@index([riskId])
  @@index([deliverableId])
}

model Decision {
  id              String   @id @default(cuid())
  projectId       String
  number          Int
  title           String
  rationale       String   @default("")
  decidedBy       String   @default("")
  decidedOn       String
  changeRequestId String?
  incidentId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest     ChangeRequest?     @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  incident          Incident?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  meetingAgreements MeetingAgreement[]

  @@unique([projectId, number])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  name        String
  description String   @default("")
  milestoneId String?
  dueDate     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt

  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?               @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  criteria       DeliverableCriterion[]
  tasks          Task[]
  reviews        DeliverableReview[]
  requirements   RequirementDeliverable[]
  qualityMetrics QualityMetric[]
  incidents      Incident[]

  @@unique([projectId, number])
  @@index([milestoneId])
}

model DeliverableCriterion {
  id            String   @id @default(cuid())
  deliverableId String
  text          String
  met           Boolean  @default(false)
  position      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

model DeliverableReview {
  id              String   @id @default(cuid())
  deliverableId   String
  outcome         String
  stakeholderId   String?
  stakeholderName String   @default("")
  reviewedOn      String
  note            String   @default("")
  attachmentId    String?
  attachmentName  String   @default("")
  /// Copia JSON de los criterios al revisar: [{ text, met }].
  criteria        String
  reviewedById    String
  createdAt       DateTime @default(now())

  deliverable Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  attachment  Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  reviewedBy  User         @relation("deliverableReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([deliverableId])
  @@index([stakeholderId])
  @@index([attachmentId])
}

model ProjectClosure {
  id            String    @id @default(cuid())
  projectId     String
  finalStatus   String
  summary       String    @default("")
  pendingReason String    @default("")
  /// Foto JSON del informe de cierre tomada al cerrar.
  report        String
  closedAt      DateTime
  closedById    String
  reopenedAt    DateTime?
  reopenedById  String?
  reopenReason  String    @default("")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedBy   User    @relation("projectCloser", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy User?   @relation("projectReopener", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@index([projectId])
}

model Lesson {
  id             String   @id @default(cuid())
  projectId      String
  authorId       String
  type           String
  category       String
  situation      String
  recommendation String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("lessonAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([category])
}

/// Bitácora de actividad (F3): una fila por escritura exitosa sobre un proyecto.
model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  action      String
  entity      String
  entityId    String?
  /// Nombre del elemento al momento del cambio.
  entityLabel String   @default("")
  /// [{ field, from?, to? }] con valores ya legibles.
  changes     Json     @default("[]")
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
}

/// Aviso dentro de la aplicación para un usuario (F2).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  kind      String
  entityId  String
  /// Etiqueta del elemento al crear el aviso: «Diseño», «INC-3 Caída».
  title     String
  /// Quien comentó; vacío en los demás tipos.
  actorName String    @default("")
  detail    String    @default("")
  /// Solo los vencimientos: impide repetir el aviso de la misma tarea y fecha.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

model BudgetCategory {
  id           String @id @default(cuid())
  projectId    String
  category     String
  plannedCents BigInt @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  date      String
  hours     Decimal  @db.Decimal(5, 2)
  note      String   @default("")
  /**
   * Tarifa del miembro al registrar; no cambia aunque luego cambie la tarifa.
   */
  rateCents BigInt   @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([userId])
}

/// Informe de estado congelado al emitirlo (F11). `report` es el JSON completo, con montos.
model StatusReport {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  periodStart String
  periodEnd   String
  report      String
  comment     String   @default("")
  nextSteps   String   @default("")
  issuedAt    DateTime @default(now())
  issuedById  String

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuedBy User    @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([projectId, number])
}

/// Fila del plan de comunicaciones (F10).
model CommunicationItem {
  id        String   @id @default(cuid())
  projectId String
  topic     String
  audience  String   @default("")
  frequency String   @default("AS_NEEDED")
  channel   String   @default("")
  ownerId   String?
  notes     String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

/// Acta de reunión (F10).
model Meeting {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  date        String
  notes       String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attendees  MeetingAttendee[]
  agreements MeetingAgreement[]

  @@index([projectId])
}

/// Asistente: un usuario o un interesado, nunca ambos.
model MeetingAttendee {
  id            String  @id @default(cuid())
  meetingId     String
  userId        String?
  stakeholderId String?

  meeting     Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@unique([meetingId, stakeholderId])
  @@index([userId])
}

/// Acuerdo de una reunión; puede convertirse en tarea, decisión o incidente.
model MeetingAgreement {
  id         String  @id @default(cuid())
  meetingId  String
  text       String
  ownerId    String?
  dueDate    String?
  position   Int     @default(0)
  taskId     String?
  decisionId String?
  incidentId String?

  meeting  Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decision Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([meetingId])
}

/// Requisito del proyecto (F12), numerado REQ-N.
model Requirement {
  id            String   @id @default(cuid())
  projectId     String
  number        Int
  description   String
  priority      String   @default("MEDIUM")
  status        String   @default("PROPOSED")
  stakeholderId String?
  acceptance    String   @default("")
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholder  Stakeholder?               @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  deliverables RequirementDeliverable[]
  changes      ChangeRequestRequirement[]

  @@unique([projectId, number])
  @@index([stakeholderId])
}

model RequirementDeliverable {
  requirementId String
  deliverableId String

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@id([requirementId, deliverableId])
  @@index([deliverableId])
}

model ChangeRequestRequirement {
  changeRequestId String
  requirementId   String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, requirementId])
  @@index([requirementId])
}

/// Métrica de calidad con meta (F13).
model QualityMetric {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  unit          String   @default("")
  target        Decimal  @db.Decimal(14, 4)
  /// HIGHER_BETTER o LOWER_BETTER.
  direction     String   @default("HIGHER_BETTER")
  deliverableId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable  Deliverable?         @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  measurements QualityMeasurement[]

  @@index([projectId])
  @@index([deliverableId])
}

model QualityMeasurement {
  id          String   @id @default(cuid())
  metricId    String
  date        String
  value       Decimal  @db.Decimal(14, 4)
  note        String   @default("")
  createdById String
  createdAt   DateTime @default(now())

  metric    QualityMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([metricId])
}

/// Evaluación de un riesgo en el tiempo (F15): se guarda al crear y cuando cambian P, I o el residual.
model RiskAssessment {
  id                  String   @id @default(cuid())
  riskId              String
  probability         Int
  impact              Int
  residualProbability Int?
  residualImpact      Int?
  assessedAt          DateTime @default(now())
  assessedById        String

  risk       Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  assessedBy User @relation(fields: [assessedById], references: [id], onDelete: Restrict)

  @@index([riskId])
}

/// Supuesto del proyecto (F15), numerado SUP-N.
model Assumption {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  description String
  ownerId     String?
  validateBy  String?
  /// PENDING, VALID o FALSE.
  status      String   @default("PENDING")
  riskId      String?
  incidentId  String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner    User?     @relation("assumptionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  risk     Risk?     @relation(fields: [riskId], references: [id], onDelete: SetNull)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([ownerId])
}

/// Pronóstico diario de un hito (F16), para su tendencia.
model MilestoneForecast {
  id           String @id @default(cuid())
  milestoneId  String
  date         String
  forecastDate String

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, date])
}

/// Pausa de un proyecto por prioridad (etapa 8). pausedOn es nulo si el proyecto ya estaba pausado antes de esta etapa.
model ProjectPause {
  id                String   @id @default(cuid())
  projectId         String
  pausedOn          String?
  reason            String   @default("")
  priorityProjectId String?
  previousStatus    String
  pausedById        String?
  resumedOn         String?
  resumedById       String?
  shiftDays         Int?
  createdAt         DateTime @default(now())

  project         Project  @relation("pausedProject", fields: [projectId], references: [id], onDelete: Cascade)
  priorityProject Project? @relation("priorityProject", fields: [priorityProjectId], references: [id], onDelete: SetNull)
  pausedBy        User?    @relation("projectPauser", fields: [pausedById], references: [id], onDelete: SetNull)
  resumedBy       User?    @relation("projectResumer", fields: [resumedById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

/// Contenido congelado del acta en cada aprobación (F18).
model CharterVersion {
  id           String   @id @default(cuid())
  projectId    String
  number       Int
  content      Json
  approvedById String?
  approvedAt   DateTime
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
}
