generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               String
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions           Session[]
  memberships        ProjectMember[]
  assignments        TaskAssignee[]
  comments           TaskComment[]
  attachments        Attachment[]
  ownedRisks         Risk[]
  approvedCharters   Charter[]
  taskSteps          TaskStep[]
  raciCells          RaciCell[]
  baselines          Baseline[]
  decidedChanges     ChangeRequest[]
  reportedIncidents  Incident[]          @relation("incidentReporter")
  ownedIncidents     Incident[]          @relation("incidentOwner")
  deliverableReviews DeliverableReview[] @relation("deliverableReviewer")
  closedProjects     ProjectClosure[]    @relation("projectCloser")
  reopenedProjects   ProjectClosure[]    @relation("projectReopener")
  lessons            Lesson[]            @relation("lessonAuthor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fallos de inicio de sesión por correo e IP, en ventanas de 15 minutos.
model LoginAttempt {
  key          String    @id
  failures     Int
  windowStart  DateTime
  blockedUntil DateTime?
}

model Project {
  id                    String    @id @default(cuid())
  name                  String
  description           String    @default("")
  status                String    @default("PLANNING")
  approach              String    @default("PREDICTIVE")
  startDate             String?
  endDate               String?
  plannedBudgetCents    BigInt    @default(0)
  currency              String    @default("USD")
  /// Último número de solicitud de cambio usado; los números no se reutilizan aunque se borre una solicitud.
  lastChangeNumber      Int       @default(0)
  lastIncidentNumber    Int       @default(0)
  lastDecisionNumber    Int       @default(0)
  lastDeliverableNumber Int       @default(0)
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  members        ProjectMember[]
  charter        Charter?
  objectives     Objective[]
  milestones     Milestone[]
  tasks          Task[]
  attachments    Attachment[]
  stakeholders   Stakeholder[]
  risks          Risk[]
  expenses       Expense[]
  raciActivities RaciActivity[]
  baselines      Baseline[]
  changeRequests ChangeRequest[]
  evmSnapshots   EvmSnapshot[]
  incidents      Incident[]
  decisions      Decision[]
  deliverables   Deliverable[]
  closures       ProjectClosure[]
  lessons        Lesson[]
}

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  projectRole String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
}

model Charter {
  id              String    @id @default(cuid())
  projectId       String    @unique
  justification   String    @default("")
  scopeIncluded   String    @default("")
  scopeExcluded   String    @default("")
  boundaries      String    @default("")
  assumptions     String    @default("")
  constraints     String    @default("")
  successCriteria String    @default("")
  sponsor         String    @default("")
  status          String    @default("DRAFT")
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation(fields: [approvedById], references: [id], onDelete: SetNull)
}

model Objective {
  id          String   @id @default(cuid())
  projectId   String
  description String
  metric      String   @default("")
  target      String   @default("")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  name      String
  dueDate   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  deliverables Deliverable[]

  @@index([projectId])
}

model Task {
  id               String   @id @default(cuid())
  projectId        String
  milestoneId      String?
  title            String
  description      String   @default("")
  status           String   @default("TODO")
  priority         String   @default("MEDIUM")
  startDate        String?
  dueDate          String?
  progress         Int      @default(0)
  plannedCostCents BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees    TaskAssignee[]
  predecessors TaskDependency[] @relation("successor")
  successors   TaskDependency[] @relation("predecessor")
  comments     TaskComment[]
  attachments  Attachment[]
  steps        TaskStep[]
  expenses     Expense[]
  incidents    Incident[]

  @@index([projectId])
}

model TaskStep {
  id         String   @id @default(cuid())
  taskId     String
  title      String
  done       Boolean  @default(false)
  assigneeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskDependency {
  predecessorId String
  successorId   String
  createdAt     DateTime @default(now())

  predecessor Task @relation("predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model Attachment {
  id           String   @id @default(cuid())
  projectId    String
  taskId       String?
  uploadedById String
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  /// Nulo mientras el archivo no se ha subido y confirmado.
  uploadedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  deliverableReviews DeliverableReview[]

  @@index([projectId])
  @@index([taskId])
}

model Stakeholder {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  organization String   @default("")
  position     String   @default("")
  contact      String   @default("")
  influence    String   @default("MEDIUM")
  interest     String   @default("MEDIUM")
  strategy     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raciCells          RaciCell[]
  deliverableReviews DeliverableReview[]

  @@index([projectId])
}

model Risk {
  id           String   @id @default(cuid())
  projectId    String
  description  String
  type         String
  probability  Int
  impact       Int
  response     String
  responsePlan String   @default("")
  ownerId      String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  incidents Incident[]

  @@index([projectId])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  description String
  amountCents BigInt
  date        String
  category    String
  taskId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
}

model RaciActivity {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cells   RaciCell[]

  @@index([projectId])
}

model RaciCell {
  id            String   @id @default(cuid())
  activityId    String
  stakeholderId String?
  userId        String?
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activity    RaciActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@unique([activityId, stakeholderId])
  @@index([stakeholderId])
  @@index([userId])
}

model Baseline {
  id              String   @id @default(cuid())
  projectId       String
  version         Int
  reason          String   @default("")
  bacCents        BigInt
  startDate       String?
  endDate         String?
  changeRequestId String?
  createdById     String
  createdAt       DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks         BaselineTask[]

  @@unique([projectId, version])
}

model BaselineTask {
  id               String @id @default(cuid())
  baselineId       String
  taskId           String
  title            String
  startDate        String
  dueDate          String
  plannedCostCents BigInt

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId])
}

model ChangeRequest {
  id                 String    @id @default(cuid())
  projectId          String
  number             Int
  title              String
  description        String    @default("")
  requestedBy        String    @default("")
  scopeImpact        String    @default("")
  scheduleImpactDays Int?
  costImpactCents    BigInt?
  status             String    @default("PENDING")
  decisionNote       String    @default("")
  decidedAt          DateTime?
  decidedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  baselines Baseline[]
  decisions Decision[]

  @@unique([projectId, number])
}

model EvmSnapshot {
  id        String @id @default(cuid())
  projectId String
  date      String
  bacCents  BigInt
  pvCents   BigInt
  evCents   BigInt
  acCents   BigInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
}

model Incident {
  id           String    @id @default(cuid())
  projectId    String
  number       Int
  title        String
  description  String    @default("")
  reportedById String
  ownerId      String?
  priority     String    @default("MEDIUM")
  dueDate      String?
  status       String    @default("OPEN")
  resolution   String    @default("")
  taskId       String?
  riskId       String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User       @relation("incidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  owner      User?      @relation("incidentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  risk       Risk?      @relation(fields: [riskId], references: [id], onDelete: SetNull)
  decisions  Decision[]

  @@unique([projectId, number])
  @@index([ownerId])
  @@index([reportedById])
  @@index([taskId])
  @@index([riskId])
}

model Decision {
  id              String   @id @default(cuid())
  projectId       String
  number          Int
  title           String
  rationale       String   @default("")
  decidedBy       String   @default("")
  decidedOn       String
  changeRequestId String?
  incidentId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  incident      Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  name        String
  description String   @default("")
  milestoneId String?
  dueDate     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?             @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  criteria  DeliverableCriterion[]
  reviews   DeliverableReview[]

  @@unique([projectId, number])
  @@index([milestoneId])
}

model DeliverableCriterion {
  id            String   @id @default(cuid())
  deliverableId String
  text          String
  met           Boolean  @default(false)
  position      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

model DeliverableReview {
  id              String   @id @default(cuid())
  deliverableId   String
  outcome         String
  stakeholderId   String?
  stakeholderName String   @default("")
  reviewedOn      String
  note            String   @default("")
  attachmentId    String?
  attachmentName  String   @default("")
  /// Copia JSON de los criterios al revisar: [{ text, met }].
  criteria        String
  reviewedById    String
  createdAt       DateTime @default(now())

  deliverable Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  attachment  Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  reviewedBy  User         @relation("deliverableReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([deliverableId])
  @@index([stakeholderId])
  @@index([attachmentId])
}

model ProjectClosure {
  id            String    @id @default(cuid())
  projectId     String
  finalStatus   String
  summary       String    @default("")
  pendingReason String    @default("")
  /// Foto JSON del informe de cierre tomada al cerrar.
  report        String
  closedAt      DateTime
  closedById    String
  reopenedAt    DateTime?
  reopenedById  String?
  reopenReason  String    @default("")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedBy   User    @relation("projectCloser", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy User?   @relation("projectReopener", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@index([projectId])
}

model Lesson {
  id             String   @id @default(cuid())
  projectId      String
  authorId       String
  type           String
  category       String
  situation      String
  recommendation String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("lessonAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([category])
}
